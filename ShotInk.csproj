<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ShotInk</RootNamespace>
    <AssemblyName>ShotInk</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>dist\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\shotink.ico</ApplicationIcon>
    <StartupObject>ShotInk.Program</StartupObject>
    <LangVersion>5</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Accessibility" />
    <Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>build\webview2\Microsoft.Web.WebView2.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>build\webview2\Microsoft.Web.WebView2.WinForms.dll</HintPath></Reference>
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="assets\shotink.ico"><LogicalName>ShotInk.ApplicationIcon</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="PrepareWebView2" BeforeTargets="ResolveAssemblyReferences">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\build-webview.ps1&quot;" />
  </Target>
</Project>
